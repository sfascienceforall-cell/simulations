SFA.page({
  matiere:"chimie",
  titre:"Chimie BA1 · compléments",
  kicker:"Université · BA1 médecine, pharmacie, biomédicales",
  intro:"Les chapitres de chimie générale et organique qui manquaient encore : nouvelles simulations et exercices étagés du ★ au ★★★★★. Ils complètent les 22 simulations de chimie et la page d'exercices existantes.",
  base:"../../secondaire/",
  nav:[["https://sciencesforall.be","Site SFA"],["../../","Simulations de physique"],["../../chimie/","Chimie BA1"],["../../secondaire/","Secondaire"],["../","Université",true],["../../prepa/","Prépa concours médecine"]],
  chapitres:[
    {id:"c01", num:1, titre:"Atome, spectre et radioactivité", resume:"Du modèle de Bohr aux désintégrations : spectres de raies, demi-vie, datation, équations nucléaires, énergie de liaison et choix d'un radiotraceur médical.", attendus:"Lire un symbole nucléaire ; relier ΔE, λ et ν (E = hc/λ) ; série de Lyman, Balmer, Paschen ; équilibrer des équations α, β⁻, β⁺, capture, γ ; N = N₀·2^(−t/T½), activité, datation au ¹⁴C ; demi-vie effective ; défaut de masse et E = Δm·c²."},
    {id:"c02", num:2, titre:"Liaison, mésomérie et hybridation", resume:"Comment les atomes se lient : hybridation et liaisons σ/π, délocalisation des électrons (structures limites), lien ordre–longueur–énergie, orbitales moléculaires des diatomiques et polarité de liaison.", attendus:"Compter σ et π ; déduire l'hybridation (sp, sp², sp³) ; écrire des structures limites et en tirer ordres de liaison et charges ; comparer longueurs et énergies de liaison ; diagramme d'OM de O₂, N₂, B₂ ; ordre de liaison et paramagnétisme ; électronégativité et type de liaison."},
    {id:"c03", num:3, titre:"VSEPR et polarité", resume:"De la formule de Lewis à la forme et à la polarité : notation AXE, molécule tournante en 3D, moments dipolaires vectoriels, charges formelles et comportement d'un dipôle dans un champ électrique.", attendus:"Notation AXₙEₘ et géométries (linéaire à octaédrique) ; effet des doublets libres sur les angles ; charges formelles ; somme vectorielle des moments de liaison, molécules polaires et apolaires ; μ = δ·e·d et pourcentage ionique ; orientation d'un dipôle dans un champ."},
    {id:"c04", num:4, titre:"Liquides, solides et forces intermoléculaires", resume:"Pourquoi les substances bouillent, fondent et se dissolvent : forces de London, dipôle–dipôle et liaison hydrogène, pression de vapeur, tension superficielle (jusqu'au surfactant pulmonaire) et mailles cristallines.", attendus:"Classer les forces intermoléculaires et prévoir des T d'ébullition ; équation de Clausius–Clapeyron ; capillarité et loi de Laplace ; types de solides ; mailles cs, cc, cfc : atomes par maille, coordinence, compacité, masse volumique."},
    {id:"c05", num:5, titre:"Thermochimie et spontanéité", resume:"Énergie et sens des réactions : cycle de Born–Haber, énergies de liaison, calorimétrie, ΔG° et constante d'équilibre selon la température, et couplage à l'ATP.", attendus:"Loi de Hess et ΔfH° ; q = m·c·ΔT et calorimétrie ; énergies de liaison ; cycle de Born–Haber et énergie réticulaire ; ΔG° = ΔH° − TΔS° ; ΔG° = −RT ln K ; ΔG = ΔG° + RT ln Q ; température de bascule ; réactions couplées (ATP)."},
    {id:"c06", num:6, titre:"Équilibre, précipitation et solubilité", resume:"Quand un solide se forme-t-il, et combien ? Comparer Q à Ks après mélange, résoudre un équilibre avec un tableau ICE, voir comment le pH, un ligand ou la température déplacent la solubilité et la constante K (calculs rénaux, produit de contraste baryté).", attendus:"Expressions de Kc, Kp et Ks ; Kp = Kc(RT)^Δn ; tableau ICE et validité de l'approximation (5 %) ; Q contre Ks, effet d'ion commun, précipitation sélective ; solubilité et pH (hydroxydes, carbonates, oxalates) ; complexation ; relation de Van 't Hoff, ΔG° = −RT ln K."},
    {id:"c07", num:7, titre:"Cinétique et mécanismes", resume:"Du tableau d'expériences à la loi de vitesse, de l'étape lente d'un mécanisme à l'énergie d'activation, puis aux applications médicales : doses répétées d'un médicament et enzymes avec leurs inhibiteurs.", attendus:"Méthode des vitesses initiales ; lois intégrées d'ordre 0, 1, 2 et demi-vies ; mécanisme, intermédiaire, étape déterminante, pré-équilibre ; Arrhenius et Ea à deux températures ; catalyseur ; accumulation et état d'équilibre pharmacocinétiques ; Michaelis-Menten, Lineweaver-Burk, inhibition compétitive et non compétitive."},
    {id:"c08", num:8, titre:"Oxydoréduction, piles et électrolyse", resume:"Équilibrer une réaction redox, prévoir la tension d'une pile avec l'équation de Nernst, relier E, ΔG et K, doser par oxydoréduction, calculer une électrolyse avec la loi de Faraday et retrouver le potentiel de membrane des cellules.", attendus:"Nombres d'oxydation ; demi-équations en milieu acide et basique ; E° de pile, ΔG° = −nFE° ; E = E° − (RT/nF) ln Q ; K à partir de E° ; piles de concentration ; courbe de dosage redox (MnO₄⁻, Cr₂O₇²⁻ sur Fe²⁺) ; produits d'électrolyse (compétition avec l'eau) ; Q = It, n(e⁻) = Q/F ; équation de Nernst appliquée aux ions K⁺, Na⁺, Cl⁻, Ca²⁺."},
    {id:"c09", num:9, titre:"Additions sur les alcènes", resume:"Pourquoi la double liaison réagit : carbocations, règle de Markovnikov, transpositions, addition anti de Br₂ et syn de H₂, effet sur la stéréochimie, stabilité des alcènes par leur chaleur d'hydrogénation et mesure de l'insaturation des lipides.", attendus:"Mécanisme AE (HBr, H₂O/H⁺, Br₂) ; stabilité des carbocations et transpositions (hydrure, méthyle) ; Markovnikov et anti-Markovnikov (peroxydes, hydroboration) ; ion bromonium et addition anti ; hydrogénation catalytique syn ; stéréospécificité (méso, racémique) ; chaleurs d'hydrogénation ; indice d'iode."},
    {id:"c10", num:10, titre:"Alcools, carbonyles, acides et dérivés", resume:"Les fonctions oxygénées du vivant : oxydation et déshydratation des alcools, acidité des acides carboxyliques et ionisation des médicaments, estérification et saponification, réduction et Grignard sur les carbonyles, liaison amide et peptides.", attendus:"Alcools 1°, 2°, 3° : oxydation ménagée ou forte, déshydratation (Zaitsev), substitution par HX ; pKa et effet inductif, résonance du carboxylate ; estérification de Fischer (K, excès, retrait d'eau), hydrolyse, saponification ; réactivité des carbonyles (aldéhyde > cétone > ester > acide) ; NaBH₄, LiAlH₄, RMgX, cyanhydrine ; liaison amide plane (résonance) ; formation d'un dipeptide."}
  ]
});
